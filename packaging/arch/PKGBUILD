# Maintainer: Abdullah Aloğlu <contact@alog.lu>

pkgname=inkubator
pkgver=2.1.0
pkgrel=1
pkgdesc='Local-first fountain pen and ink collection manager'
arch=('x86_64')
url='https://github.com/aloglu/inkubator'
license=('MIT')
options=('!lto')
depends=(
  'gtk3'
  'libayatana-appindicator'
  'webkit2gtk-4.1'
)
makedepends=(
  'base-devel'
  'cargo'
  'file'
  'nodejs'
  'npm'
  'pkgconf'
  'rust'
)
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  # Keep Rust's native dependencies, especially ring, on the system GCC linker.
  # Some user makepkg environments inject lld and can fail with missing ring_core symbols.
  export CC=gcc
  export CXX=g++
  export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=gcc
  local rustflags_cleaned="${RUSTFLAGS:-}"
  rustflags_cleaned="${rustflags_cleaned//-C link-arg=-fuse-ld=lld/}"
  rustflags_cleaned="${rustflags_cleaned//-Clink-arg=-fuse-ld=lld/}"
  export RUSTFLAGS="${rustflags_cleaned}"
  export CFLAGS="${CFLAGS//-flto=auto/}"
  export CXXFLAGS="${CXXFLAGS//-flto=auto/}"
  export LDFLAGS="${LDFLAGS//-flto=auto/}"
  export LDFLAGS="${LDFLAGS//-flto/}"

  npm ci
  npm run build:linux:deb -- --ci
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  local deb_path
  deb_path="$(find src-tauri/target/release/bundle/deb -maxdepth 1 -type f -name 'Inkubator_*.deb' -print -quit)"
  if [[ -z "${deb_path}" ]]; then
    echo 'Could not find Tauri DEB bundle output.' >&2
    return 1
  fi

  local extract_dir="${srcdir}/deb-payload"
  rm -rf "${extract_dir}"
  mkdir -p "${extract_dir}"
  ar x "${deb_path}" --output "${extract_dir}"
  tar -xzf "${extract_dir}/data.tar.gz" -C "${pkgdir}"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
