{
  "name": "inkubator",
  "version": "2.0.0",
  "description": "Local-first desktop application for the management and cataloging of fountain pen and ink collections.",
  "scripts": {
    "start": "tauri dev",
    "tauri": "tauri",
    "showcase": "serve app",
    "sync-version": "node scripts/sync-version.mjs",
    "build": "tauri build",
    "build:win": "tauri build --bundles nsis",
    "build:mac": "tauri build --bundles dmg,app",
    "build:linux": "tauri build --bundles deb,rpm",
    "build:linux:deb": "tauri build --bundles deb",
    "build:linux:rpm": "tauri build --bundles rpm",
    "docker:start": "node server/docker-server.js",
    "docker:build": "docker build -t inkubator:local .",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "fountain-pens",
    "tracker",
    "tauri"
  ],
  "author": {
    "name": "Abdullah Aloğlu",
    "email": "contact@alog.lu"
  },
  "homepage": "https://github.com/aloglu/inkubator",
  "repository": {
    "type": "git",
    "url": "https://github.com/aloglu/inkubator.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "fs-extra": "^11.3.3",
    "serve": "^14.2.6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "adm-zip": "^0.5.17"
  }
}
