{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inkubator",
  "version": "2.1.0",
  "identifier": "com.aloglu.inkubator",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Inkubator",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../app": "app"
    },
    "targets": [
      "deb",
      "rpm",
      "nsis",
      "dmg",
      "app"
    ],
    "publisher": "Abdullah Aloğlu",
    "homepage": "https://github.com/aloglu/inkubator",
    "license": "MIT",
    "category": "Utility",
    "copyright": "Copyright © Abdullah Aloğlu",
    "shortDescription": "Local-first fountain pen and ink collection manager.",
    "longDescription": "Inkubator is a local-first desktop application for managing and cataloging fountain pen and ink collections. It stores data and images locally and can export a static showcase.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "xdg-desktop-portal-gtk",
          "zenity"
        ]
      },
      "rpm": {
        "depends": [
          "xdg-desktop-portal-gtk",
          "zenity"
        ]
      }
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
