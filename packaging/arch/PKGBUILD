# Maintainer: Abdullah Aloğlu <contact@alog.lu>

pkgname=inkubator
pkgver=2.1.0
pkgrel=1
pkgdesc='Local-first fountain pen and ink collection manager'
arch=('x86_64')
url='https://github.com/aloglu/inkubator'
license=('MIT')
options=('!lto')
depends=(
  'cairo'
  'dbus'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libgcc'
  'libsoup3'
  'pango'
  'webkit2gtk-4.1'
  'xdg-desktop-portal-gtk'
  'zenity'
)
makedepends=(
  'nodejs-lts-krypton'
  'npm'
  'rust'
)
source=(
  "${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
  '0001-limit-manifest-fallback-to-debug-builds.patch'
)
sha256sums=(
  'f70c9ea9b995ee26bfbd08f1214022e2e262baffa01679bc5bfa334a9cee52ae'
  '632e917941e00bfd837e6ddd2f580f58285bef10196f8058d15464a828598276'
)

prepare() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  patch -Np1 -i "${srcdir}/0001-limit-manifest-fallback-to-debug-builds.patch"

  export npm_config_cache="${srcdir}/npm-cache"
  npm ci \
    --ignore-scripts \
    --include=dev \
    --include=optional \
    --no-audit \
    --no-fund

  export CARGO_HOME="${srcdir}/cargo-home"
  cargo fetch \
    --locked \
    --target "${CARCH}-unknown-linux-gnu" \
    --manifest-path src-tauri/Cargo.toml
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  export npm_config_cache="${srcdir}/npm-cache"
  export npm_config_offline=true
  npm ci \
    --offline \
    --include=dev \
    --include=optional \
    --no-audit \
    --no-fund

  export CARGO_HOME="${srcdir}/cargo-home"
  export CARGO_NET_OFFLINE=true

  # Keep Rust's native dependencies, especially ring, on the system GCC linker.
  # Some user makepkg environments inject lld and can fail with missing ring_core symbols.
  export CC=gcc
  export CXX=g++
  export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=gcc
  local rustflags_cleaned="${RUSTFLAGS:-}"
  rustflags_cleaned="${rustflags_cleaned//-C link-arg=-fuse-ld=lld/}"
  rustflags_cleaned="${rustflags_cleaned//-Clink-arg=-fuse-ld=lld/}"
  export RUSTFLAGS="${rustflags_cleaned}"
  export CFLAGS="${CFLAGS//-flto=auto/}"
  export CXXFLAGS="${CXXFLAGS//-flto=auto/}"
  export LDFLAGS="${LDFLAGS//-flto=auto/}"
  export LDFLAGS="${LDFLAGS//-flto/}"

  npm run build:linux:deb -- --ci -- --frozen
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  local deb_path
  deb_path="$(find src-tauri/target/release/bundle/deb -maxdepth 1 -type f -name 'Inkubator_*.deb' -print -quit)"
  if [[ -z "${deb_path}" ]]; then
    echo 'Could not find Tauri DEB bundle output.' >&2
    return 1
  fi

  local extract_dir="${srcdir}/deb-payload"
  rm -rf "${extract_dir}"
  mkdir -p "${extract_dir}"
  ar x "${deb_path}" --output "${extract_dir}"
  tar -xzf "${extract_dir}/data.tar.gz" -C "${pkgdir}"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
